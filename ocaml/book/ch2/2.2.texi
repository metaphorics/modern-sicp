fold_left  ( /. ) [ 1.0; 2.0; 3.0 ] 1.0
fold_right (fun x y -> x :: y) [ 1; 2; 3 ] []
fold_left  (fun x y -> y :: x) [ 1; 2; 3 ] []
@end example

