6 * (5 * (4 * factorialRecursive(3)))                                \
6 * (5 * (4 * (3 * factorialRecursive(2))))                            \
6 * (5 * (4 * (3 * (2 * factorialRecursive(1)))))                        |
6 * (5 * (4 * (3 * (2 * 1))))                                            /
6 * (5 * (4 * (3 * 2)))                                                /
6 * (5 * (4 * 6))                                                    /
6 * (5 * 24)                                                       /
6 * 120                                                          /
720          <-------------------------------------------------
@end example
@end quotation
@end ifinfo
