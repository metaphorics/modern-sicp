  (Node
     [ Leaf 1
     ; Node [ Leaf 2; Node [ Leaf 3; Leaf 4 ]; Leaf 5 ]
     ; Node [ Leaf 6; Leaf 7 ]
     ]);;
(* => Node [Leaf 1; Node [Leaf 4; Node [Leaf 9; Leaf 16]]; Leaf 25; Node [Leaf 36; Leaf 49]] *)
@end example

