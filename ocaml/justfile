# Create the pinned switch if absent, then install the locked dependencies.
setup:
    opam switch list --short | grep -qx 5.5.1 || opam switch create 5.5.1
    opam install --switch=5.5.1 --yes . --deps-only --locked --with-dev-setup

# Check formatting with ocamlformat through dune.
fmt:
    opam exec --switch=5.5.1 -- dune build @fmt

# Compile the workspace with warnings as errors.
lint:
    opam exec --switch=5.5.1 -- dune build

# Run the main-text tests; pending exercise scaffolds never run here.
test:
    opam exec --switch=5.5.1 -- dune runtest

# Surface pending exercise scaffolds; exits nonzero while solutions are unsolved.
scaffold:
    opam exec --switch=5.5.1 -- dune build @scaffold

# Build the edition book (HTML, EPUB 3, PDF) into book/_build/.
book-html-epub:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f book/main.texi ]; then
        echo "ocaml/book/main.texi is missing; the edition book tree is created in Phase A3" >&2
        exit 1
    fi
    uv run --directory .. tools/build_css.py --assets text/assets/css --out ocaml/book
    cd book
    rm -rf _build/html
    mkdir -p _build/html
    ../../tools/texi2any_html.sh --html --split=section -c HIGHLIGHT_SYNTAX=pygments \
        --css-include=book.css -o _build/html main.texi
    uv run --directory ../.. tools/edition_switcher.py --html ocaml/book/_build/html --edition ocaml
    uv run --directory ../.. tools/check_html_assets.py --html ocaml/book/_build/html --site-root .
    uv run --directory ../.. tools/math_check.py --html ocaml/book/_build/html --source ocaml/book
    ../../tools/texi2any_html.sh --epub3 -c HIGHLIGHT_SYNTAX=pygments \
        --css-include=book-epub.css -o _build/ocaml-sicp.epub main.texi
    uv run --directory ../.. tools/epub_manifest_fix.py --epub ocaml/book/_build/ocaml-sicp.epub
    epubcheck _build/ocaml-sicp.epub

book-pdf:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f book/main.texi ]; then
        echo "ocaml/book/main.texi is missing" >&2
        exit 1
    fi
    uv run --directory .. tools/figures_pdf.py --src text/original/figures --out text/original/figures/pdf
    cd book
    mkdir -p _build
    texi2dvi --expand --pdf --batch --build=local -o _build/ocaml-sicp.pdf main.texi

book: book-html-epub book-pdf
