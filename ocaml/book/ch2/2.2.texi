|             | right-split |    | split| split| corner-split|
|             |             |    |      |      |             |
|             |     n-1     |    |  n-1 |  n-1 |     n-1     |
|             |             |    |      |      |             |
|  identity   +-------------+    +------+------+-------------+
|             |             |    |             | right-split |
|             | right-split |    |             |     n-1     |
|             |             |    |  identity   +-------------+
|             |     n-1     |    |             | right-split |
|             |             |    |             |     n-1     |
+-------------+-------------+    +-------------+-------------+

       right-split n                    corner-split n
@end example

@end quotation
@end ifinfo
@ifhtml
@image{../../text/original/figures/chap2/Fig2.13a,,132mm,Figure 2.13: Recursive plans for right-split and corner-split.,.std.svg}
@end ifhtml
@iftex
@image{../../text/original/figures/pdf/chap2/Fig2.13a.std,,132mm,,.pdf}

@end iftex
@caption{@strong{Figure 2.13:} Recursive plans for @code{right_split} and @code{corner_split}.}
