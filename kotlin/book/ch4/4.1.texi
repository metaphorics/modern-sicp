    """
    ((lambda (n)
       ((lambda (fact) (fact fact n))
        (lambda (ft k)
          (if (= k 1)
              1
              (* k (ft ft (- k 1)))))))
     10)
    """.trimIndent(),
    env,
)
// => 3628800
@end example

