  map ⟨??⟩ m
;;

let transpose mat =
  accumulate_n ⟨??⟩ ⟨??⟩ mat
;;

let matrix_times_matrix m n =
  let cols = transpose n in
  map ⟨??⟩ m
;;
@end example
@end quotation

