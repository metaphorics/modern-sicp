@noindent
We can produce balanced patterns by branching upwards as well as towards the
right (see @ref{Exercise 2.44}, @ref{Figure 2.13} and @ref{Figure 2.14}):

@example kotlin
fun cornerSplit(
    painter: Painter,
    n: Int,
): Painter =
    if (n == 0) @{
        painter
    @} else @{
        val up = upSplit(painter, n - 1)
        val right = rightSplit(painter, n - 1)
        val topLeft = beside(up, up)
        val bottomRight = below(right, right)
        val corner = cornerSplit(painter, n - 1)
        beside(below(painter, topLeft), below(bottomRight, corner))
    @}
@end example

