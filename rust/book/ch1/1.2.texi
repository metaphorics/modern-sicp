 ..       / . . \   .  .   /  . \   .  .   / .  \   .  . 1 .
.      fib2 . . fib1.  .fib1 .  fib0 . .fib1. . fib0 .  .  .
.      /  \  . . |  .  . |  .  . |   . . |   . . |   .   .>
V     /  . \   . 1  .  . 1  .  . 0  .  . 1  .  . 0  ..
.  fib1 .. fib0..  .   .   .   .   .   V   .   ..  . 
.   |  .  . |  . .>     .>.     . .    ..>.      .>
.   1 .   . 0  .      
 .   .     .  .       
  .>.       ..        

@end example
@end ifinfo
@ifhtml
@image{../../text/original/figures/chap1/Fig1.5d,,147mm,Figure 1.5: The tree-recursive process generated in computing (fib 5).,.std.svg}
@end ifhtml
@iftex
@image{../../text/original/figures/pdf/chap1/Fig1.5d.std,147mm,,,.pdf}

