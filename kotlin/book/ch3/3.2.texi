           | makeWithdraw: ...                  |
global --->|                                    |
env        | w1: --+                            |
           +-------|----------------------------+
                   |                   ^
                   |                   |
                   |            +--------------+
                   |     E1 --->| balance: 100 |
                   |            | b: 50        |
                   |            +--------------+
                   V                   ^
               .---.---.               |
               | O | O-+---------------+
               `-|-^---'
                 |
                 V
          parameters: amount
          body: ...
@end example
@end ifinfo
@ifhtml
@image{../../text/original/figures/chap3/Fig3.9b,,147mm,Figure 3.9: Environments after the call to w1. The artwork's balance label denotes the captured b cell.,.std.svg}
@end ifhtml
