@strong{@anchor{Exercise 2.63}Exercise 2.63:} Each of the following two
procedures converts a binary tree to a list.

@example typescript
export const treeToList1 = (tree: TreeSet): List<number> =>
  tree._tag === "Empty"
    ? nil
    : append(
        treeToList1(tree.left),
        cons(tree.entry, treeToList1(tree.right)),
      );

export const treeToList2 = (tree: TreeSet): List<number> => @{
  const copyToList = (
    t: TreeSet,
    resultList: List<number>,
  ): List<number> =>
    t._tag === "Empty"
      ? resultList
      : copyToList(
          t.left,
          cons(t.entry, copyToList(t.right, resultList)),
        );
  return copyToList(tree, nil);
@};
@end example

