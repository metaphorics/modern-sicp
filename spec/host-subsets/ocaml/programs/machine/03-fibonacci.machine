(* Tree-recursive Fibonacci machine (lesson: two recursive calls and stack use). *)
Machine
  { registers = [ "n"; "val"; "continue" ]
  ; operations =
      [ ("<", [ Int_type; Int_type ], Bool_type)
      ; ("+", [ Int_type; Int_type ], Int_type)
      ; ("-", [ Int_type; Int_type ], Int_type)
      ]
  ; inputs = [ ("n", Int 10) ]
  ; controller =
      [ Assign ("continue", Label_ref "done")
      ; Label "fib"
      ; Test ("<", [ Reg "n"; Const (Int 2) ])
      ; Branch "immediate-answer"
      ; Save "continue"
      ; Assign ("continue", Label_ref "afterfib-n-1")
      ; Save "n"
      ; Assign_op ("n", "-", [ Reg "n"; Const (Int 1) ])
      ; Goto "fib"
      ; Label "afterfib-n-1"
      ; Restore "n"
      ; Restore "continue"
      ; Assign_op ("n", "-", [ Reg "n"; Const (Int 2) ])
      ; Save "continue"
      ; Assign ("continue", Label_ref "afterfib-n-2")
      ; Save "val"
      ; Goto "fib"
      ; Label "afterfib-n-2"
      ; Assign ("n", Reg "val")
      ; Restore "val"
      ; Restore "continue"
      ; Assign_op ("val", "+", [ Reg "val"; Reg "n" ])
      ; Goto_reg "continue"
      ; Label "immediate-answer"
      ; Assign ("val", Reg "n")
      ; Goto_reg "continue"
      ; Label "done"
      ]
  }
