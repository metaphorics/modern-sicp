        ),
    ),
)
db.assertFact(
    QFact(
        QList(
            listOf(
                QSym("meeting"),
                QSym("administration"),
                QList(
                    listOf(
                        QSym("Monday"),
                        QSym("10am"),
                    ),
                    null,
                ),
            ),
            null,
        ),
    ),
)
db.assertFact(
    QFact(
        QList(
            listOf(
                QSym("meeting"),
                QSym("computer"),
                QList(
                    listOf(
                        QSym("Wednesday"),
                        QSym("3pm"),
                    ),
