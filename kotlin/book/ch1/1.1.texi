val b = a + 1L

a + b + (a * b)

a == b

if (b > a && b < a * b) b else a

when @{
    a == 4L -> 6L
    b == 4L -> 6L + 7L + a
    else -> 25L
@}

2L + (if (b > a) b else a)

(when @{
    a > b -> a
    a < b -> b
    else -> -1L
@}) * (a + 1L)
