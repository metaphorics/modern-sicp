@subsection Compiling Combinations

The compiler handles calls in @code{compileApplication}. It compiles the
callee into @code{val}, saves that value in @code{proc}, and compiles the
arguments into @code{argl} in source order. The only target is @code{"val"}.

@example typescript
const operator = compileExpression(
  expr.callee,
  "val",
  nextLinkage,
  context,
);
if (isCompileError(operator)) @{
  return operator;
@}
const toProc = makeSequence(
  ["val"],
  ["proc"],
  [save("proc"), assign("proc", register("val"))],
);
const operands = compileOperandList(expr.args, context);
if (isCompileError(operands)) @{
  return operands;
@}
@end example

@noindent
The operand helper starts with an empty argument list. It evaluates each
operand in order, saves the current list while it compiles that operand, then
adds the value to the list:

@example typescript
const compileOperandList = (
  args: ReadonlyArray<Arg>,
  context: CompileContext,
): CompileResult => @{
  let collected = makeSequence(
    ["val"],
    ["argl"],
    [assign("argl", op("empty-argl"))],
  );
  for (const arg of args) @{
    const piece = compileExpression(
      arg.expr,
      "val",
      nextLinkage,
      context,
    );
    if (isCompileError(piece)) @{
      return piece;
    @}
    const join = makeSequence(
      ["val", "argl"],
      ["argl"],
      [
        restore("argl"),
        assign(
          "argl",
          op("adjoin-arg", register("val"), register("argl")),
        ),
      ],
    );
    collected = appendInstructionSequences(
      collected,
      makeSequence([], ["argl"], [save("argl")]),
      piece,
      join,
    );
  @}
  return collected;
@};
@end example

@subsubheading Applying procedures

The compiler emits a dispatch sequence inside @code{compileApplication}. A
primitive call uses @code{apply-primitive-procedure}. A closure call extends
the closure's captured environment with the arguments and jumps to its entry
label:

@example typescript
test("is-primitive-procedure", register("proc")),
branch(primitive),
gotoLabel(compound),
assign(
  "val",
  op("apply-primitive-procedure", register("proc"), register("argl")),
),
assign(
  "env",
  op(
    "extend-environment",
    op("procedure-parameters", register("proc")),
    register("argl"),
    op("procedure-environment", register("proc")),
  ),
),
assign("item", op("procedure-entry", register("proc"))),
gotoRegister("item"),
@end example

@noindent
The caller stores an @code{after-call} label in @code{continue} before the
closure call. The closure returns there, and the compiler restores the saved
registers. This path does not eliminate tail calls. Measure stack use instead
of inferring it from guest tail position.

