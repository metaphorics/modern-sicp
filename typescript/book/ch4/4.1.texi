// even/odd:
interface OddEven @{
  run: (self: OddEven, other: OddEven, n: number) => boolean;
@}

const f = (x: number): boolean =>
  ((even: OddEven, odd: OddEven): boolean => even.run(even, odd, x))(
    @{ run: (self, other, n) => (n === 0
      ? true
      : other.run(⟨??⟩, ⟨??⟩, ⟨??⟩)) @},
    @{ run: (self, other, n) => (n === 0
      ? false
      : self.run(⟨??⟩, ⟨??⟩, ⟨??⟩)) @},
  );
@end smallexample
@end enumerate
@end quotation
