@example rust
pub fn encode(message: &[Symbol], tree: &HuffmanTree) -> Result<Vec<bool>, SchemeError> @{
    let mut bits = Vec::new();
    for symbol in message @{
        bits.extend(encode_symbol(symbol, tree)?);
