            6 ---->|  eval  |----> 720
                   +--------+
                       /
             . . .    /  . . .
       . . .       ../. .      .
     .                           ..
    .   fun factorial(n: Long): Long @{   . . .
   .       if (n == 1L) return 1L             . .
    .       return n * factorial(n - 1L)      .
    .   @}
    .   fun main() @{
   .       println(factorial(6L))             .
    .   @}
      . .                       . .        .
          . .  . .      . . . .     . . . .
                   . ..
@end smallexample
@end ifinfo
