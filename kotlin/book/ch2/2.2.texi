val wave4 = below(wave2, wave2)
@end example
@end quotation
@end ifinfo
@ifhtml
@image{../../text/original/figures/chap2/Fig2.12,,118mm,Figure 2.12: Creating a complex figure@comma{} starting from the wave painter of Figure 2.10.,.std.svg}
