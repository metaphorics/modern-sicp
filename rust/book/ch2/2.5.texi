following to the @code{complex} package:''

@example rust
table.put(
    Key::sym("real-part"),
    key_list(&[Key::sym("complex")]),
    Rc::new(|args: &[Value]| real_part_dispatch(&args[0])),
);
table.put(
    Key::sym("imag-part"),
    key_list(&[Key::sym("complex")]),
