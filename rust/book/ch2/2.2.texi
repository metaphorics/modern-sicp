@example rust
pub fn square_limit(painter: &Painter, n: u32) -> Painter @{
    (square_of_four(
        painter_op(flip_horiz),
        identity_op(),
        painter_op(rotate_180),
        painter_op(flip_vert),
    ))(&corner_split(painter, n))
@}
