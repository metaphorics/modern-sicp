{
  "build": [],
  "run": [
    "node",
    "--experimental-strip-types",
    "packages/ch5/src/conformance-driver.ts",
    "--case",
    "{case}",
    "--engine",
    "{engine}",
    "--source",
    "{source}",
    "--work",
    "{work}"
  ],
  "native_compile": [
    "node",
    "node_modules/typescript/bin/tsc",
    "--ignoreConfig",
    "--noEmit",
    "--pretty",
    "false",
    "--target",
    "es2024",
    "--lib",
    "es2024",
    "--module",
    "nodenext",
    "--moduleResolution",
    "nodenext",
    "--types",
    "node",
    "--strict",
    "--noUncheckedIndexedAccess",
    "--exactOptionalPropertyTypes",
    "--noImplicitOverride",
    "--noFallthroughCasesInSwitch",
    "--noPropertyAccessFromIndexSignature",
    "--noImplicitReturns",
    "--allowUnreachableCode",
    "false",
    "--verbatimModuleSyntax",
    "--erasableSyntaxOnly",
    "--allowImportingTsExtensions",
    "--skipLibCheck",
    "{source}"
  ],
  "native_run": [
    "node",
    "--experimental-strip-types",
    "{source}"
  ]
}
