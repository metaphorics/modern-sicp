@strong{@anchor{Exercise 2.63}Exercise 2.63:} Each of the following two
procedures converts a binary tree to a list.

@example ocaml
let rec tree_to_list_1 = function
  | Empty -> []
  | Node (left, entry, right) -> tree_to_list_1 left @@ (entry :: tree_to_list_1 right)
;;

let tree_to_list_2 tree =
  let rec copy_to_list tree result_list =
    match tree with
    | Empty -> result_list
    | Node (left, entry, right) -> copy_to_list left (entry :: copy_to_list right result_list)
  in
  copy_to_list tree []
;;
@end example

