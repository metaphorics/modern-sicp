# TypeScript edition: gates and the book build.
# Node 24.21.0 is installed by mise; every recipe puts it first on PATH.

export PATH := env_var_or_default("HOME", ".") + "/.local/share/mise/installs/node/24.21.0/bin:" + env_var_or_default("PATH", "")

# Install the pinned toolchain (Node 24.21.0, pnpm 12.5.1) and dependencies.
setup:
	mise install || nvm install
	corepack enable 2>/dev/null || npm install --global pnpm@12.5.1
	pnpm install --frozen-lockfile

# Check formatting (no writes).
fmt:
	pnpm biome format .

# Lint and type-check every chapter package.
lint:
	pnpm biome check .
	pnpm -r --filter './packages/*' exec tsc --noEmit

# Run the chapter test suites.
test:
	pnpm vitest run

# List pending exercise scaffolds; never runs in CI and may exit nonzero.
scaffold:
	pnpm vitest run --reporter=verbose 2>&1 | grep -i todo

# Build the edition book (HTML, EPUB, PDF). The book tree lands in Phase A3;
# the commands follow step 5 of "Text pipeline and demolition" in the plan.
book-html-epub:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f book/main.texi ]; then
        echo "typescript/book/main.texi is missing; the edition book tree is created in Phase A3" >&2
        exit 1
    fi
    uv run --directory .. tools/build_css.py --assets text/assets/css --out typescript/book
    cd book
    rm -rf _build/html
    mkdir -p _build/html
    ../../tools/texi2any_html.sh --html --split=section -c HIGHLIGHT_SYNTAX=pygments \
        --css-include=book.css -o _build/html main.texi
    # Pages reference edition-rendered figures as figures/... (book-relative,
    # the one shape both the HTML splitter and the EPUB image copier resolve).
    # Stage copies beside the pages and beside the epub output so the built
    # tree is self-contained and check_html_assets resolves them.
    rm -rf _build/html/figures _build/figures
    cp -r figures _build/html/figures
    cp -r figures _build/figures
    uv run --directory ../.. tools/edition_switcher.py --html typescript/book/_build/html --edition typescript
    uv run --directory ../.. tools/check_html_assets.py --html typescript/book/_build/html --site-root .
    uv run --directory ../.. tools/math_check.py --html typescript/book/_build/html --source typescript/book
    # No HIGHLIGHT_SYNTAX here: texi2any 7.3 wraps multi-line pygments
    # output in a div inside the example pre, which epubcheck rejects
    # (RSC-005).  EPUB ships unhighlighted, as the first shipped epubs did.
    ../../tools/texi2any_html.sh --epub3 \
        --css-include=book-epub.css -o _build/typescript-sicp.epub main.texi
    uv run --directory ../.. tools/epub_manifest_fix.py --epub typescript/book/_build/typescript-sicp.epub
    epubcheck _build/typescript-sicp.epub

book-pdf:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f book/main.texi ]; then
        echo "typescript/book/main.texi is missing" >&2
        exit 1
    fi
    uv run --directory .. tools/figures_pdf.py --src text/original/figures --out text/original/figures/pdf
    cd book
    # The PDF image references need PDF renders of the edition-generated
    # figures; rsvg-convert renders the committed .std.svg sources.
    for svg in figures/generated/*/*.std.svg; do
        rsvg-convert -f pdf -o "${svg%.std.svg}.pdf" "$svg"
    done
    mkdir -p _build
    texi2dvi --expand --pdf --batch --build=local -o _build/typescript-sicp.pdf main.texi

book: book-html-epub book-pdf
