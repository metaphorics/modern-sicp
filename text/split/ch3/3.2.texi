@image{../../text/original/figures/chap3/Fig3.9b,,147mm,Figure 3.9: Environments after the call to @code{W1}.,.std.svg}
@end ifhtml
@iftex
@image{../../text/original/figures/chap3/Fig3.9b,,147mm,,.pdf}

@end iftex
@caption{@strong{Figure 3.9:} Environments after the call to @code{W1}.}
