@quotation
@strong{@anchor{Exercise 2.63}Exercise 2.63:} Each of the following two
functions converts a binary tree to a list.

@example kotlin
fun treeToList1(tree: SetTree): List<Long> =
    when (tree) @{
        is SetTree.Empty -> emptyList()
        is SetTree.Node ->
            treeToList1(tree.left) +
                listOf(tree.entry) +
                treeToList1(tree.right)
    @}

fun treeToList2(tree: SetTree): List<Long> @{
    fun copyToList(
        tree: SetTree,
        result: List<Long>,
    ): List<Long> =
        when (tree) @{
            is SetTree.Empty -> result
            is SetTree.Node ->
                copyToList(
                    tree.left,
                    listOf(tree.entry) +
                        copyToList(tree.right, result),
                )
        @}
    return copyToList(tree, emptyList())
@}
@end example

