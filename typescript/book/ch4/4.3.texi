procedures

@example typescript
/** Exercise 4.54's `require?`: the tagged `require` form. */
export const isRequire = (
  expr: Expr
): boolean => expr.tag === "require";

/** Exercise 4.54's `requirePredicate`. */
export const requirePredicate = (
  expr: Expr,
): Expr | undefined =>
  expr.tag === "require" ? expr.condition : undefined;
